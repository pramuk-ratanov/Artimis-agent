# Artimis Environment Configuration Example
# Copy this file to .env and fill in your values

# Project root (where database, files, skills live)
# Default: ~/.artimis  |  Set to "." to use the project folder
ARTIMIS_HOME=.

# DeepSeek API Key (for DeepSeek model provider)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Artimis API Key (for authenticating to the Artimis API)
ARTIMIS_API_KEY=your_artimis_api_key_here

# Allowed CORS origins for the Artimis API server
ARTIMIS_ALLOWED_ORIGINS=http://localhost:7002,http://127.0.0.1:7002,http://100.95.117.9:7002